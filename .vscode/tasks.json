{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "构建网站",
      "type": "process",
      "command": "pnpm",
      "windows": { "command": "pnpm.cmd" },
      "args": ["run", "build"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "检查 TypeScript",
      "type": "process",
      "command": "pnpm",
      "windows": { "command": "pnpm.cmd" },
      "args": ["run", "typecheck"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "运行全部测试",
      "type": "process",
      "command": "pnpm",
      "windows": { "command": "pnpm.cmd" },
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "本地预览（静态网页）",
      "type": "process",
      "command": "python",
      "args": ["-m", "http.server", "8000", "--directory", "site"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "构建网站",
      "problemMatcher": []
    }
  ]
}
