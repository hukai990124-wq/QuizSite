      "**/__pycache__": true,
      "**/assets/*.css": true,
      "**/assets/*.js": true,
      "**/assets/*.mjs": true,
      "**/.build": true,
      "**/aws-aif/**/*.html": true,
      "**/aws-aip/**/*.html": true,
