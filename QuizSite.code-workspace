{
  "folders": [
    { "name": "01 HTML · 网页", "path": "site" },
    { "name": "02 CSS · 样式", "path": "src/css" },
    { "name": "03 JavaScript · 交互", "path": "src/javascript" },
    { "name": "04 TypeScript · 交互", "path": "src/typescript" },
    { "name": "05 题库 · 资料与生成脚本", "path": "question-banks" },
    { "name": "06 后端 · API 与数据库", "path": "worker" },
    { "name": "07 工具 · 判分与多语言", "path": "quiz_kit" },
    { "name": "08 文档 · 维护说明", "path": "docs" },
    { "name": "QuizSite", "path": "." }
  ],
  "settings": {
    "files.encoding": "utf8",
    "files.exclude": {
      "**/node_modules": true,
      "**/.wrangler": true,
      "**/__pycache__": true,
      "**/assets/*.css": true,
      "**/assets/*.js": true,
      "**/assets/*.mjs": true
    },
    "search.exclude": {
      "**/node_modules/**": true,
      "**/.wrangler/**": true,
      "**/__pycache__/**": true,
      "**/out/**": true,
      "**/output/**": true,
      "**/assets/*.css": true,
      "**/assets/*.js": true,
      "**/assets/*.mjs": true
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
      "*.mts": "${capture}.mjs, ${capture}.d.mts",
      "tsconfig.json": "tsconfig.*.json"
    },
    "task.allowAutomaticTasks": "off"
  }
}
