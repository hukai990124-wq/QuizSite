      "**/aws-saa/**/*.html": true,
      "**/dele-a1/**/*.html": true,
      "**/dele-a2/**/*.html": true,
      "**/fe/**/*.html": true,
      "**/java-bronze/**/*.html": true,
      "**/programming/**/*.html": true,
      "**/toeic-listening/**/*.html": true,
      "**/toeic-reading/**/*.html": true,
      "**/workbuddy-opc/**/*.html": true
    },
    "search.exclude": {
      "**/node_modules/**": true,
      "**/.wrangler/**": true,
      "**/__pycache__/**": true,
      "**/out/**": true,
      "**/output/**": true,
      "**/assets/*.css": true,
      "**/assets/*.js": true,
      "**/assets/*.mjs": true,
      "**/.build": true,
      "**/aws-aif/**/*.html": true,
      "**/aws-aip/**/*.html": true,
      "**/aws-clf/**/*.html": true,
      "**/aws-mla/**/*.html": true,
      "**/aws-saa/**/*.html": true,
      "**/dele-a1/**/*.html": true,
      "**/dele-a2/**/*.html": true,
      "**/fe/**/*.html": true,
      "**/java-bronze/**/*.html": true,
      "**/programming/**/*.html": true,
      "**/toeic-listening/**/*.html": true,
      "**/toeic-reading/**/*.html": true,
      "**/workbuddy-opc/**/*.html": true
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
      "*.mts": "${capture}.mjs, ${capture}.d.mts",
      "tsconfig.json": "tsconfig.*.json"
    },
    "task.allowAutomaticTasks": "off"
  }
