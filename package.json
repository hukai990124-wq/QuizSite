{
  "name": "quizbank",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.site.json --noEmitOnError && tsc -p tsconfig.worker.json --noEmitOnError",
    "test": "pnpm run build && node --test worker/*.test.mjs tests/*.test.mjs site/assets/back-to-top.test.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
