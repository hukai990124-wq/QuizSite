# ============================================================
#  题库站点仓库 · 排除规则
#
#  三条原则：
#   1. 官方试卷原件（raw/）永不上传 —— 版权材料，与仓库公开与否无关
#   2. 解析中间件（parse/ parsed/ _seg/）不入库 —— 体积大且可从 raw 重新生成
#   3. 截图与手工备份不入库 —— 噪声，不是交付物
#
#  不带前导斜杠的目录名会匹配任意层级，例如 raw/ 可命中
#  aws-saa/raw、dele-a1/raw、toeic-listening/raw、toeic-reading/raw
# ============================================================

# ---- 1. 版权材料：官方试卷 / 题库原件 ----
raw/

# ---- 2. 解析中间件（可由 raw/ 重新生成）----
parse/
parsed/
_seg/

# ---- 3. 截图与手工备份 ----
shots/
_shots/
_backups/

# ---- 4. 工具与系统垃圾 ----
.workbuddy/
__pycache__/
*.pyc
*.pyo
*.log
Thumbs.db
desktop.ini
.DS_Store

# ---- 5. 生成过程的中间件（可由 build_audio.py / crop_audio.py 重建）----
_tts_tmp/
_imgtest/

# ---- 6. 一次性分析脚本与采集结果（只限仓库根目录的 _ 前缀临时件）----
/_*.py
/_*.json
/_*.txt
/_*.md
/_*.png
/_*.mp3

# ---- 7. Local Wrangler state and caches ----
.wrangler/
/node_modules/

# Browser CSS/JS are generated by pnpm build from src/. Keep HTML, data and media.
/site/assets/*.css
/site/assets/*.js
/site/assets/*.mjs
!/site/assets/*.test.mjs

# Compiled TypeScript bank publisher.
/.build/

# Subject pages are generated by the shared TypeScript publisher.
/site/aws-aif/**/*.html
/question-banks/aws-aif/**/*.html
/site/aws-aip/**/*.html
/question-banks/aws-aip/**/*.html
/site/aws-clf/**/*.html
/question-banks/aws-clf/**/*.html
/site/aws-mla/**/*.html
/question-banks/aws-mla/**/*.html
/site/aws-saa/**/*.html
/question-banks/aws-saa/**/*.html
/site/dele-a1/**/*.html
/question-banks/dele-a1/**/*.html
/site/dele-a2/**/*.html
/question-banks/dele-a2/**/*.html
/site/fe/**/*.html
/question-banks/fe/**/*.html
/site/java-bronze/**/*.html
/question-banks/java-bronze/**/*.html
/site/programming/**/*.html
/question-banks/programming/**/*.html
/site/toeic-listening/**/*.html
/question-banks/toeic-listening/**/*.html
/site/toeic-reading/**/*.html
/question-banks/toeic-reading/**/*.html
/site/workbuddy-opc/**/*.html
/question-banks/workbuddy-opc/**/*.html
/site/fe/*.json
