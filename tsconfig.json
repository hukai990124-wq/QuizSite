{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "noEmitOnError": true
  },
  "include": [
    "worker/chat.mts",
    "worker/gavin-speech.mts",
    "worker/gavin-conversation.mts",
    "worker/sir-gavin-prompt.mts",
    "worker/weekly-study.mts",
    "worker/registration-turnstile.mts",
    "worker/account.d.mts",
    "src/typescript/**/*.mts",
    "src/typescript/**/*.ts"
  ]
}
