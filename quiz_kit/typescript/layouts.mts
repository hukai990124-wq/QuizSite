  "style-0820fd8cdbdb8d6802b9": [
    "<style>\r\n  body{margin:0;background:#f5f6f8;font:15px/1.7 -apple-system,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;color:#111827}\r\n  .wrap{max-width:760px;margin:0 auto;padding:46px 22px 70px}\r\n  h1{font-size:27px;margin:0 0 8px;letter-spacing:.2px}\r\n  .sub{color:#6b7280;margin:0 0 30px;font-size:14px}\r\n  .grp{margin:0 0 26px}\r\n  .grp h2{font-size:14px;color:#6b7280;font-weight:600;margin:0 0 10px;letter-spacing:.6px}\r\n  a.card{display:flex;justify-content:space-between;align-items:center;gap:16px;background:#fff;\r\n    border:1px solid #e3e6ea;border-radius:12px;padding:16px 20px;margin-bottom:10px;\r\n    text-decoration:none;color:#111827;transition:.15s}\r\n  a.card:hover{border-color:#93c5fd;background:#f8fbff;transform:translateY(-1px)}\r\n  a.card .tx{flex:1 1 auto;min-width:0}\r\n  .n{font-weight:700;font-size:16px;display:block;margin-bottom:3px}\r\n  .d{color:#6b7280;font-size:13px}\r\n  .tag{font-size:11px;padding:2px 9px;border-radius:999px;white-space:nowrap;border:1px solid}\r\n  .tag.warn{color:#b45309;background:#fffbeb;border-color:#fde68a}\r\n  .tag.ok{color:#047857;background:#ecfdf5;border-color:#a7f3d0}\r\n  .tag.off{color:#1d4ed8;background:#eff6ff;border-color:#bfdbfe}\r\n  .pg{position:relative;margin-top:9px}\r\n  .pg::before{content:\"\";position:absolute;left:0;right:0;top:0;height:5px;background:#e9eef2;border-radius:99px}\r\n  .pg i{position:relative;display:block;height:5px;width:0;background:#0b6b3a;border-radius:99px;transition:width .3s}\r\n  .pg span{display:block;font-size:12px;color:#8b95a1;margin-top:6px}\r\n  .pg.on span{color:#0b6b3a;font-weight:600}\r\n  .note{background:#fff;border:1px solid #e3e6ea;border-radius:12px;padding:18px 20px;font-size:13.5px;color:#374151}\r\n  .note b{color:#111827}\r\n  .note ul{margin:8px 0 0;padding-left:20px}\r\n  .note li{margin:5px 0}\r\n  code{background:#f1f5f9;border-radius:4px;padding:1px 5px;font-size:12.5px}\r\n</style>"
