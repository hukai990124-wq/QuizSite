    "\r\n<!--/i18n:head--></head>\r\n<body><a href=\"../index.html\" title=\"返回题库总览\" style=\"position:fixed;right:14px;top:14px;z-index:99;background:rgba(255,255,255,.95);border:1px solid #d8dee5;border-radius:99px;padding:6px 14px;font:12.5px/1.4 -apple-system,'Segoe UI','Microsoft YaHei',sans-serif;color:#334155;text-decoration:none;box-shadow:0 1px 4px rgba(0,0,0,.10)\">← 题库总览</a>\r\n<div class=\"wrap\">\r\n  <h1>",
    {
      "slot": "h1.1"
    },
    "</h1>\n  <p class=\"sub\">",
    {
      "slot": "p.2"
    },
    "</p>\r\n  <div class=\"random-entry\"><strong>随机出题</strong><span>仅从 A、C 线抽取标准单选、多选题</span><a href=\"../random.html?pool=aws-saa&amp;size=50\">随机 50 题</a></div>\r\n\r\n  <div class=\"grp\">\n    <h2>",
    {
      "slot": "h2.3"
    },
    "</h2>\n    <a class=\"card\" href=\"reference.html\">\n      <span class=\"tx\"><span class=\"n\">SAA 服务与术语集</span>\n      <span class=\"d\">118 项服务 · 97 个核心术语 · 用途、功能与概念辨析 · 可搜索查阅</span></span>\n      <span class=\"tag off\">阅读参考</span>\n    </a>\n  </div>\n\n  <div class=\"grp\">\n    <h2>",
