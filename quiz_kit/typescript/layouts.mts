  "script-9a6bc507129f24742ce7": [
    "<script>\r\n(function(){\r\n\"use strict\";\r\nfunction qa(s){return Array.prototype.slice.call(document.querySelectorAll(s))}\r\nfunction refreshProgress(){\nqa(\"[data-quiz-group]\").forEach(function(el){\r\n  var g=el.getAttribute(\"data-quiz-group\");\r\n  var cnt=parseInt(el.getAttribute(\"data-quiz-count\")||\"1\",10);\r\n  var total=parseInt(el.getAttribute(\"data-quiz-total\")||\"0\",10);\r\n  var d=0,o=0;\r\n  for(var i=1;i<=cnt;i++){\r\n    var key=\"quiz:\"+(el.getAttribute(\"data-quiz-key\")||g+\":\"+(\"0\"+i).slice(-2));\n    var S={};\r\n    try{S=JSON.parse(localStorage.getItem(key)||\"{}\")||{}}catch(e){S={}}\r\n    Object.keys(S).forEach(function(k){\r\n      var r=S[k];\r\n      if(r&&r.ok!==null&&!r.revealed){d++;if(r.ok)o++}\r\n    });\r\n  }\r\n  var bar=el.querySelector(\".pg i\"),txt=el.querySelector(\".pg span\");\r\n  if(bar)bar.style.width=(total?d/total*100:0)+\"%\";\r\n  if(txt)txt.textContent=d?(d+\"/\"+total+\" 题 · 正确率 \"+Math.round(o/d*100)+\"%\"):\"未开始\";\r\n  var c=el.querySelector(\".pg\");if(c)c.classList.toggle(\"on\",!!d);\n});\n}\nrefreshProgress();\nwindow.addEventListener(\"quizsite:progress-updated\",refreshProgress);\nwindow.addEventListener(\"storage\",function(event){\n  if(event.key===null||event.key.indexOf(\"quiz:\")===0)refreshProgress();\n});\r\n})();\r\n</script>"
  ],
